      "zone_member": [],
      "comment": "Zone1 admin - PI of the genomics lab"
    },
    {
      "username": "rkumar",
      "full_name": "Dr. Raj Kumar",
      "role": "HPC Systems Administrator",
      "department": "Research Computing",
      "zone_admin": ["hpc_scratch", "research_commons"],
      "zone_member": [],
