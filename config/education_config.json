{
  "dataset": {
    "name": "education",
    "label": "University Research Computing"
  },

  "shared_volume": {
    "name": "campus",
    "mount": "/mnt/campus"
  },

  "global_role": {
    "name": "CampusTaggers",
    "capability": "TagApplier"
  },

  "home": {
    "subdir": "research",
    "template_key": "academic"
  },

